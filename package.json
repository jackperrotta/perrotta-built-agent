{
  "name": "construction-scanning-platform",
  "version": "0.0.1",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "build": "tsc -b",
    "clean": "rm -rf dist node_modules **/*/node_modules **/*/dist",
    "start": "npx tsx apps/backend/src/main.ts",
    "dev:backend": "npm run dev --workspace=apps/backend",
    "dev:web": "npm run start --workspace=apps/web",
    "dev": "concurrently \"npm run dev:backend\" \"npm run dev:web\""
  },
  "dependencies": {
    "typescript": "^5.3.3",
    "@types/node": "^20.11.5",
    "tsx": "^4.7.0"
  },
  "devDependencies": {
    "concurrently": "^9.2.1",
    "eslint": "^8.56.0",
    "prettier": "^3.2.4"
  }
}