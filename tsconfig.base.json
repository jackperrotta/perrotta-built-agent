{
    "compilerOptions": {
        "target": "ES2022",
        "module": "NodeNext",
        "moduleResolution": "NodeNext",
        "lib": [
            "ES2022",
            "DOM"
        ],
        "declaration": true,
        "declarationMap": true,
        "sourceMap": true,
        "strict": true,
        "esModuleInterop": true,
        "skipLibCheck": true,
        "forceConsistentCasingInFileNames": true,
        "composite": true,
        "rootDir": ".",
        "baseUrl": ".",
        "paths": {
            "@construction/shared": [
                "packages/shared/src/index.ts"
            ],
            "@construction/geometry": [
                "packages/geometry/src/index.ts"
            ],
            "@construction/audio": [
                "packages/audio/src/index.ts"
            ],
            "@construction/vision": [
                "packages/vision/src/index.ts"
            ],
            "@construction/layout": [
                "packages/layout/src/index.ts"
            ]
        }
    },
    "exclude": [
        "node_modules",
        "**/dist",
        "**/coverage"
    ]
}